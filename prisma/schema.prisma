// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////
// MÓDULO M3 – USUARIOS Y SEGURIDAD
//////////////////////////////

model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  nombre       String
  email        String   @unique
  password_hash String
  activo       Boolean
  created_at   DateTime

  // Relaciones
  solicitudes_compra SolicitudCompra[]
  recepciones        Recepcion[]
  usuarioRoles       UsuarioRol[]
}

model Rol {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique

  rolPermisos  RolPermiso[]
  usuarioRoles UsuarioRol[]
}

model Permiso {
  id          String @id @default(uuid()) @db.Uuid
  codigo      String @unique
  descripcion String

  rolPermisos RolPermiso[]
}

model UsuarioRol {
  usuario_id String @db.Uuid
  rol_id     String @db.Uuid

  usuario Usuario @relation(fields: [usuario_id], references: [id])
  rol     Rol     @relation(fields: [rol_id], references: [id])

  @@id([usuario_id, rol_id]) // Equivalente al índice único (usuario_id, rol_id)
}

model RolPermiso {
  rol_id     String @db.Uuid
  permiso_id String @db.Uuid

  rol     Rol     @relation(fields: [rol_id], references: [id])
  permiso Permiso @relation(fields: [permiso_id], references: [id])

  @@id([rol_id, permiso_id]) // Equivalente al índice único (rol_id, permiso_id)
}

//////////////////////////////
// MÓDULO M1 – SERVICIOS DE SALUD
//////////////////////////////

model Paciente {
  id               String            @id @default(uuid()) @db.Uuid
  nombre           String
  dni              String            @unique
  fecha_nacimiento DateTime

  citas            Cita[]
  consumos         ConsumoPaciente[]
}

model Medico {
  id           String @id @default(uuid()) @db.Uuid
  nombre       String
  especialidad String

  citas        Cita[]
}

model Cita {
  id          String   @id @default(uuid()) @db.Uuid
  fecha       DateTime
  motivo      String
  estado      String
  paciente_id String   @db.Uuid
  medico_id   String   @db.Uuid

  paciente Paciente @relation(fields: [paciente_id], references: [id])
  medico   Medico   @relation(fields: [medico_id], references: [id])

  atenciones AtencionMedica[]
}

model AtencionMedica {
  id            String   @id @default(uuid()) @db.Uuid
  cita_id       String   @unique @db.Uuid
  diagnostico   String
  observaciones Json     // jsonb
  fecha         DateTime

  cita          Cita        @relation(fields: [cita_id], references: [id])
  procedimientos Procedimiento[]
  consumos       ConsumoPaciente[]
}

model Procedimiento {
  id          String @id @default(uuid()) @db.Uuid
  atencion_id String @db.Uuid
  descripcion String
  cantidad    Int
  insumo_id   String @db.Uuid

  atencion AtencionMedica @relation(fields: [atencion_id], references: [id])
  insumo   Insumo         @relation(fields: [insumo_id], references: [id])
}

//////////////////////////////
// MÓDULO M4 – INVENTARIO MÉDICO
//////////////////////////////

model Insumo {
  id            String @id @default(uuid()) @db.Uuid
  nombre        String
  categoria     String
  unidad_medida String
  stock_actual  Int
  stock_minimo  Int

  movimientos MovimientoInsumo[]
  consumos    ConsumoPaciente[]
  solicitudItems SolicitudCompraItem[]
  ordenItems     OrdenCompraItem[]
  recepcionDetalles RecepcionDetalle[]
  procedimientos Procedimiento[]
}

model MovimientoInsumo {
  id        String   @id @default(uuid()) @db.Uuid
  insumo_id String   @db.Uuid
  tipo      String   // entrada/salida
  cantidad  Int
  origen    String
  fecha     DateTime

  insumo Insumo @relation(fields: [insumo_id], references: [id])
}

model ConsumoPaciente {
  id          String   @id @default(uuid()) @db.Uuid
  paciente_id String   @db.Uuid
  insumo_id   String   @db.Uuid
  cantidad    Int
  atencion_id String   @db.Uuid
  fecha       DateTime

  paciente Paciente       @relation(fields: [paciente_id], references: [id])
  insumo   Insumo         @relation(fields: [insumo_id], references: [id])
  atencion AtencionMedica @relation(fields: [atencion_id], references: [id])
}

//////////////////////////////
// MÓDULO M2 – COMPRAS
//////////////////////////////

model Proveedor {
  id       String @id @default(uuid()) @db.Uuid
  nombre   String
  ruc      String @unique
  telefono String
  direccion String

  ordenes OrdenCompra[]
}

model SolicitudCompra {
  id         String   @id @default(uuid()) @db.Uuid
  fecha      DateTime
  estado     String
  creado_por String   @db.Uuid
  area       String

  creador Usuario @relation(fields: [creado_por], references: [id])

  items       SolicitudCompraItem[]
  ordenes     OrdenCompra[]
}

model SolicitudCompraItem {
  id           String @id @default(uuid()) @db.Uuid
  solicitud_id String @db.Uuid
  insumo_id    String @db.Uuid
  cantidad     Int

  solicitud SolicitudCompra @relation(fields: [solicitud_id], references: [id])
  insumo    Insumo          @relation(fields: [insumo_id], references: [id])
}

model OrdenCompra {
  id           String   @id @default(uuid()) @db.Uuid
  proveedor_id String   @db.Uuid
  solicitud_id String   @db.Uuid
  fecha        DateTime
  estado       String

  proveedor Proveedor      @relation(fields: [proveedor_id], references: [id])
  solicitud SolicitudCompra @relation(fields: [solicitud_id], references: [id])

  items      OrdenCompraItem[]
  recepciones Recepcion[]
}

model OrdenCompraItem {
  id             String   @id @default(uuid()) @db.Uuid
  orden_id       String   @db.Uuid
  insumo_id      String   @db.Uuid
  cantidad       Int
  precio_unitario Decimal @db.Decimal

  orden  OrdenCompra @relation(fields: [orden_id], references: [id])
  insumo Insumo      @relation(fields: [insumo_id], references: [id])
}

model Recepcion {
  id          String   @id @default(uuid()) @db.Uuid
  orden_id    String   @db.Uuid
  fecha       DateTime
  responsable String   @db.Uuid

  orden OrdenCompra @relation(fields: [orden_id], references: [id])
  usuario Usuario   @relation(fields: [responsable], references: [id])

  detalles RecepcionDetalle[]
}

model RecepcionDetalle {
  id               String @id @default(uuid()) @db.Uuid
  recepcion_id     String @db.Uuid
  insumo_id        String @db.Uuid
  cantidad_recibida Int

  recepcion Recepcion @relation(fields: [recepcion_id], references: [id])
  insumo    Insumo    @relation(fields: [insumo_id], references: [id])
}